# Fly.io deploy config for scripts/deploy_fly.py (standard: flyio-deployment).
# Copy to .env (gitignored), fill in, then:
#   python scripts/deploy_fly.py            # first time: create app + volume + deploy
#   python scripts/deploy_fly.py --deploy   # subsequent: sync + deploy
#   ./scripts/deploy_fly.ps1 --status       # Windows wrapper (finds python, forwards args)
#
# Named .env.example (not .env.template) because .gitignore whitelists only that name.

# REQUIRED -- FLY_APP_NAME MUST match `app = "..."` in fly.toml (deploy reads fly.toml).
FLY_APP_NAME=
FLY_VOLUME_NAME=journal_data

# OPTIONAL (defaults shown)
FLY_REGION=sin
FLY_VOLUME_SIZE_GB=1
# FLY_API_TOKEN=            # paste a token to skip the interactive `fly auth login`

# GitHub backup mirror -- OPT-IN (default off; deploy is --local-only, never needs GitHub)
FLY_ENABLE_GITHUB=0
# FLY_GITHUB_REPO=

# APP SECRETS: any key NOT prefixed FLY_/CF_ is pushed via `fly secrets set`.
# The journal is public-write by default. To lock create/update behind an
# x-write-secret header, set this (app reads it as runtimeConfig.writeSecret):
# NUXT_WRITE_SECRET=
